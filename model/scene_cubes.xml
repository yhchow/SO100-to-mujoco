<mujoco model="so_arm100 cube scene">
  <include file="so_arm100.xml"/>

  <statistic center="0 -0.15 0.1" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <!-- 30 mm cubes: the jaw opens to 77 mm, so there is room to drop over one
         and still close 15 mm past its faces. condim=4 adds torsional friction,
         without which a cube spins out from between the pads. -->
    <default class="cube">
      <geom type="box" size="0.015 0.015 0.015" mass="0.03" condim="4"
            friction="1.5 0.05 0.002" solimp="0.97 0.99 0.001" solref="0.004 1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 -0.2 1.2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Overhead camera looking straight down at the cube area. -->
    <camera name="overhead" pos="0 -0.18 0.55" xyaxes="1 0 0 0 1 0" fovy="58"/>

    <!-- Cube positions come from an FK sweep of poses that can reach tabletop
         height with the gripper pointing down: that region is densest around
         y = -0.12..-0.24, |x| < 0.15. See README "Cube placement". -->
    <body name="cube_red" pos="-0.10 -0.18 0.015">
      <freejoint name="cube_red_free"/>
      <geom class="cube" name="cube_red" rgba="0.85 0.25 0.20 1"/>
    </body>
    <body name="cube_green" pos="0 -0.21 0.015">
      <freejoint name="cube_green_free"/>
      <geom class="cube" name="cube_green" rgba="0.25 0.70 0.35 1"/>
    </body>
    <body name="cube_blue" pos="0.10 -0.18 0.015">
      <freejoint name="cube_blue_free"/>
      <geom class="cube" name="cube_blue" rgba="0.25 0.45 0.85 1"/>
    </body>
  </worldbody>
</mujoco>
